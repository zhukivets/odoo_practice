<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Book Views -->
    <record id="view_library_book_tree" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list string="Books">
                <field name="name"/>
                <field name="author"/>
                <field name="isbn"/>
                <field name="publish_year"/>
            </list>
        </field>
    </record>

    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="author"/>
                        <field name="isbn"/>
                        <field name="publish_year"/>
                    </group>
                    <notebook>
                        <page string="Copies">
                            <field name="copy_ids">
                                <list>
                                    <field name="inventory_number"/>
                                    <field name="condition"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Copy Views -->
    <record id="view_library_copy_tree" model="ir.ui.view">
        <field name="name">library.copy.list</field>
        <field name="model">library.copy</field>
        <field name="arch" type="xml">
            <list string="Copies">
                <field name="inventory_number"/>
                <field name="book_id"/>
                <field name="condition"/>
            </list>
        </field>
    </record>

    <!-- Member Views -->
    <record id="view_library_member_tree" model="ir.ui.view">
        <field name="name">library.member.list</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <list string="Members">
                <field name="membership_number"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
            </list>
        </field>
    </record>

    <record id="view_library_member_form" model="ir.ui.view">
        <field name="name">library.member.form</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <form string="Member">
                <sheet>
                    <group>
                        <field name="membership_number"/>
                        <field name="name"/>
                        <field name="email"/>
                        <field name="phone"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Loan Views -->
    <record id="view_library_loan_tree" model="ir.ui.view">
        <field name="name">library.loan.list</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <list string="Loans">
                <field name="copy_id"/>
                <field name="member_id"/>
                <field name="loan_date"/>
                <field name="due_date"/>
                <field name="return_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_library_loan_form" model="ir.ui.view">
        <field name="name">library.loan.form</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <form string="Loan">
                   <header>
                        <button name="action_return" string="Return" type="object"
                            class="btn-primary" invisible="state == 'returned'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                <sheet>
                    <group>
                        <group string="Main Info">
                            <field name="copy_id"/>
                            <field name="member_id"/>
                        </group>
                            <group string="Dates">
                             <field name="loan_date"/>
                             <field name="due_date"/>
                             <field name="return_date"/>
                             <field name="is_overdue"/>
                             <field name="fine_amount" invisible="fine_amount == 0"/>
                             </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_library_book" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_library_copy" model="ir.actions.act_window">
        <field name="name">Copies</field>
        <field name="res_model">library.copy</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_library_member" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">library.member</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_library_loan" model="ir.actions.act_window">
        <field name="name">Loans</field>
        <field name="res_model">library.loan</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Structure -->
    <menuitem id="menu_library_root" name="Library" sequence="10"/>
    <menuitem id="menu_library_books" name="Books" parent="menu_library_root" action="action_library_book" sequence="1"/>
    <menuitem id="menu_library_copies" name="Copies" parent="menu_library_root" action="action_library_copy" sequence="2"/>
    <menuitem id="menu_library_members" name="Members" parent="menu_library_root" action="action_library_member" sequence="3"/>
    <menuitem id="menu_library_loans" name="Loans" parent="menu_library_root" action="action_library_loan" sequence="4"/>
</odoo>